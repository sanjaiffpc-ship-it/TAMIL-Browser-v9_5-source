{
  "manifest_version": 3,
  "name": "TAMIL Sound Control Panel",
  "version": "8.0",
  "description": "TAMIL Ultimate Premium V1 - WhatsApp Web & Discord call audio panel, mic/camera status and call troubleshooting.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "TAMIL", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_page": "options.html",
  "permissions": ["storage", "contentSettings"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://discord.com/*"],
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*", "https://discord.com/*"], "js": ["pre.js", "engine.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
